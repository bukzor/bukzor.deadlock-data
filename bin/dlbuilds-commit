#!/bin/bash
# Commit the repo's builds file, labeled with its build counts -- only if it
# differs from HEAD and passes dlbuilds-validate. Commits no other paths.
set -euo pipefail
# shellcheck source=../lib/common.sh
source "$(dirname "$0")/../lib/common.sh"

if git -C "$REPO" diff --quiet HEAD -- "$BUILDS_REL"; then
  exit 0
fi
counts="$(dlbuilds-validate "$BUILDS")" || {
  log "refusing (gate failed): $counts"
  exit 1
}
git -C "$REPO" commit -q -m "builds snapshot $(date -Is) ($counts)

Validate-gated by bin/dlbuilds-commit." -- "$BUILDS_REL"
log "COMMITTED: $counts"
