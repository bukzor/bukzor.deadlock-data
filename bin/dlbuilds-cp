#!/bin/bash
# Copy builds file SRC over DST -- only if SRC passes dlbuilds-validate, so a
# crash-truncated/empty save never replaces a good one. Silent when identical.
set -euo pipefail
# shellcheck source=../lib/common.sh
source "$(dirname "$0")/../lib/common.sh"

src="$1" dst="$2"
counts="$(dlbuilds-validate "$src")" || {
  log "refusing (gate failed): $counts: $src"
  exit 1
}
if ! cmp -s "$src" "$dst"; then
  cp "$src" "$dst"
  log "copied ($counts): $src -> $dst"
fi
