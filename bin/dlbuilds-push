#!/bin/bash
# Rebase onto upstream, then push. Idempotent; a failed push is retried next
# pass. On conflict, local commits win (-X theirs; with .gitattributes -merge,
# the whole builds file, never a hunk-by-hunk mix). Remote versions stay in
# history.
set -euo pipefail
# shellcheck source=../lib/common.sh
source "$(dirname "$0")/../lib/common.sh"

export GIT_SSH_COMMAND="ssh -o BatchMode=yes"
git -C "$REPO" pull -q --rebase --autostash -X theirs
git -C "$REPO" push -q
