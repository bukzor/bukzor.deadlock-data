#!/bin/bash
# One full pass: capture -> commit -> push. Run periodically by
# etc/service/deadlock-builds. Push happens only when ahead of upstream, so a
# failed push is retried next pass; no branch/upstream fails loudly.
set -euo pipefail
# shellcheck source=../lib/common.sh
source "$(dirname "$0")/../lib/common.sh"

"$REPO/bin/capture"
"$REPO/bin/commit"
if [[ "$(git -C "$REPO" rev-list --count '@{upstream}..HEAD')" != 0 ]]; then
  GIT_SSH_COMMAND="ssh -o BatchMode=yes" git -C "$REPO" push -q
  log "pushed"
fi
