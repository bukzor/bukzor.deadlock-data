#!/bin/bash
# List the builds files -- live save and repo copy -- with size and mtime.
set -euo pipefail
# shellcheck source=../lib/common.sh
source "$(dirname "$0")/../lib/common.sh"

list() {
  local label="$1" file="$2"
  if [[ -e $file ]]; then
    printf '%7s  %s  %s  %s\n' "$(stat -c %s "$file")" "$(date -r "$file" '+%F %R')" "$label" "$file"
  else
    printf '%7s  %-16s  %s  %s\n' - missing "$label" "$file"
  fi
}
list live "$LIVE"
list repo "$BUILDS"
