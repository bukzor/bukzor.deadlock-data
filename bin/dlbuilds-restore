#!/bin/bash
# Install builds FILE (default: the repo copy) over the live Deadlock save.
#
# Refuses while Deadlock runs: its cloud sync would re-clobber the file, and the
# file is usually locked. FORCE=1 overrides. Copies via the dlbuilds-cp gate,
# then stamps mtime to now so Steam treats local as newest and uploads it.
set -euo pipefail
# shellcheck source=../lib/common.sh
source "$(dirname "$0")/../lib/common.sh"

if [[ ${FORCE:-0} != 1 ]] && dlbuilds-game-running; then
  log "Deadlock is running. Exit it fully (tray icon -> Exit), then re-run. (FORCE=1 overrides.)"
  exit 1
fi

dlbuilds-cp "${1:-$BUILDS}" "$LIVE"
touch "$LIVE"
log "OK. Now start Deadlock so it uploads this copy."
