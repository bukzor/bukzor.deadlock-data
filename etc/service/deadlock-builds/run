#!/bin/sh
# runit service: validate-gated snapshot of the live Deadlock builds file.
# Install from a dedicated clone, never a working checkout (see README): each
# pass commits, rebases, and pushes, which would race interactive git work.
# runsvdir (root) picks it up within ~5s. Each pass drops to bukzor before
# touching the repo, so commits carry the right identity and SSH keys, and runs
# under `uv run --locked`, so .venv tracks uv.lock as passes pull new code.
exec 2>&1
REPO="$(cd -P ../../.. && pwd)"  # runsv starts us in this service dir
LOG=/home/bukzor/deadlock-builds-recovery/snapshotter.log
INTERVAL=120

while true; do
    chpst -u bukzor:bukzor \
        env HOME=/home/bukzor PATH=/usr/bin:/bin:/usr/sbin:/sbin \
        uv run -q --locked --project "$REPO" "$REPO/bin/dlbuilds-snapshot" >>"$LOG" 2>&1
    sleep "$INTERVAL"
done
